{
  "testDirs": [
    "tests"
  ],
  "harnessPaths": [
    ".claude/hooks",
    ".claude/settings.json",
    ".github/workflows",
    ".github/scripts",
    "playwright.config.cjs",
    "tests/server.cjs"
  ],
  "testCommand": "node --test && npx playwright test",
  "testTimeoutSec": 840,
  "setupCheck": [
    "node_modules/@playwright/test"
  ],
  "setupCommand": "npm i --no-save @playwright/test@1.56.1",
  "stopLossAfter": 3,
  "tailLines": 60,
  "site": {
    "pages": [
      "index.html"
    ],
    "inappLock": "full",
    "settleMs": 1500
  }
}
